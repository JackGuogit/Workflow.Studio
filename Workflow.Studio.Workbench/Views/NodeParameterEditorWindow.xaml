<Window x:Class="Workflow.Studio.Workbench.Views.NodeParameterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Workflow.Studio.Workbench.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Text="{Binding Node.Title}" />
            <TextBlock Margin="0 8 0 0"
                       Foreground="#5B6474"
                       Text="{Binding Description}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0 16 0 0"
                Padding="12"
                Background="#F4F7FB"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock Text="{Binding NodeTypeText}" />
        </Border>

        <Grid Grid.Row="2"
              Margin="0 16 0 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:NodeParameterItemViewModel}">
                            <Border Margin="0 0 0 12"
                                    Padding="14"
                                    Background="White"
                                    BorderBrush="#D7DEE8"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Key}" />
                                        <Border Grid.Column="1"
                                                Padding="8 2"
                                                Background="#EEF2FF"
                                                CornerRadius="999">
                                            <TextBlock Foreground="#3730A3"
                                                       Text="{Binding TypeName}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Margin="0 8 0 0"
                                               Foreground="#6B7280"
                                               Text="{Binding EditorHint}" />

                                    <TextBox Grid.Row="2"
                                             Margin="0 10 0 0"
                                             MinHeight="72"
                                             Padding="10"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Padding="20"
                    Background="#F9FAFB"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="当前节点没有可编辑参数" />
                    <TextBlock Margin="0 8 0 0"
                               HorizontalAlignment="Center"
                               Foreground="#6B7280"
                               Text="此节点仍然可以参与执行和连线。"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasParameters}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0 20 0 0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="96"
                    Height="36"
                    Margin="0 0 10 0"
                    IsCancel="True"
                    Content="取消" />
            <Button Width="96"
                    Height="36"
                    Click="SaveButton_Click"
                    Content="保存" />
        </StackPanel>
    </Grid>
</Window>
