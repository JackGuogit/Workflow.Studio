<UserControl x:Class="Workflow.Studio.Workbench.Views.Editor.WorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nodify="clr-namespace:Workflow.Studio.Nodify;assembly=Workflow.Studio.Nodify"
             xmlns:session="clr-namespace:Workflow.Studio.Core.Session;assembly=Workflow.Studio.Core"
             d:DesignHeight="760"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="NodeHeaderTemplate">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="11"
                           Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                           Text="{Binding Category}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NodePortRowTemplate">
            <Border Margin="0,2" Padding="6,3"
                    Background="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}"
                    CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                               Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                               Text="{Binding TypeDisplayText}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               Foreground="{DynamicResource WorkflowWorkbench.TextBrush}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NodeToolTipTemplate">
            <StackPanel MaxWidth="300" Margin="4">
                <TextBlock FontWeight="Bold" Text="{Binding Title}"
                           Foreground="{DynamicResource WorkflowWorkbench.TextBrush}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                           Text="{Binding Description}" />
                <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}"
                           Text="{Binding NodeTypeText}" />
                <TextBlock Margin="0,8,0,0" FontSize="11"
                           Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                           Text="{Binding PortSummary}" />
                <TextBlock Margin="0,4,0,0" FontSize="11"
                           Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                           Text="输入" />
                <ItemsControl ItemsSource="{Binding Inputs}"
                              ItemTemplate="{StaticResource NodePortRowTemplate}" />
                <TextBlock Margin="0,6,0,0" FontSize="11"
                           Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                           Text="输出" />
                <ItemsControl ItemsSource="{Binding Outputs}"
                              ItemTemplate="{StaticResource NodePortRowTemplate}" />
                <TextBlock Margin="0,8,0,0" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                           Text="{Binding PreviewText}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NodeCardTemplate">
            <StackPanel>
                <Border x:Name="NodeGlyph" Width="38" Height="38" CornerRadius="9"
                        Background="{DynamicResource WorkflowWorkbench.AccentBrush}">
                    <TextBlock x:Name="NodeGlyphText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" FontWeight="Bold" Foreground="White" Text="N" />
                </Border>
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                           Text="{Binding StateText}" FontSize="10"
                           Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}" />
                <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse x:Name="ReadyDot" Width="6" Height="6" Margin="2"
                             Fill="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}" />
                    <Ellipse x:Name="RunDot" Width="6" Height="6" Margin="2"
                             Fill="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}" />
                    <Ellipse x:Name="DoneDot" Width="6" Height="6" Margin="2"
                             Fill="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                           Text="{Binding BreakpointText}" FontSize="10" Foreground="#C77" />
                <TextBlock Margin="0,2,0,0" MaxWidth="150" TextWrapping="Wrap" TextAlignment="Center"
                           Text="{Binding ErrorText}" FontSize="10" Foreground="#C00" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="Source">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="#FB923C" />
                    <Setter TargetName="NodeGlyphText" Property="Text" Value="IN" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Transform">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="#FACC15" />
                    <Setter TargetName="NodeGlyphText" Property="Text" Value="FX" />
                    <Setter TargetName="NodeGlyphText" Property="Foreground" Value="#111827" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Output">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="#38BDF8" />
                    <Setter TargetName="NodeGlyphText" Property="Text" Value="OUT" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="OpenCV">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="#A78BFA" />
                    <Setter TargetName="NodeGlyphText" Property="Text" Value="CV" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Succeeded}">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="{DynamicResource WorkflowWorkbench.SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Failed}">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="{DynamicResource WorkflowWorkbench.ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Running}">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Paused}">
                    <Setter TargetName="NodeGlyph" Property="Background" Value="{DynamicResource WorkflowWorkbench.SecondaryAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Configured}">
                    <Setter TargetName="ReadyDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Running}">
                    <Setter TargetName="RunDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Succeeded}">
                    <Setter TargetName="DoneDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static session:NodeState.Failed}">
                    <Setter TargetName="DoneDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.ErrorBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ConnectionTemplate">
            <nodify:LineConnection Source="{Binding SourcePort.Anchor}" Target="{Binding TargetPort.Anchor}"
                                   Style="{StaticResource WorkflowWorkbench.LineConnectionStyle}" />
        </DataTemplate>

        <DataTemplate x:Key="PendingConnectionTemplate">
            <nodify:PendingConnection
                StartedCommand="{Binding StartCommand}"
                CompletedCommand="{Binding FinishCommand}"
                AllowOnlyConnectors="True"
                EnablePreview="True"
                EnableSnapping="True"
                Style="{StaticResource WorkflowWorkbench.PendingConnectionStyle}" />
        </DataTemplate>

        <Style x:Key="WorkbenchItemContainerStyle"
               BasedOn="{StaticResource WorkflowWorkbench.ItemContainerStyle}"
               TargetType="{x:Type nodify:ItemContainer}">
            <Setter Property="Location" Value="{Binding Location}" />
            <Setter Property="ActualSize" Value="{Binding Size, Mode=OneWayToSource}" />
        </Style>

        <Style x:Key="WorkbenchNodeInputStyle"
               BasedOn="{StaticResource WorkflowWorkbench.NodeInputStyle}"
               TargetType="{x:Type nodify:NodeInput}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorkbenchNodeOutputStyle"
               BasedOn="{StaticResource WorkflowWorkbench.NodeOutputStyle}"
               TargetType="{x:Type nodify:NodeOutput}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorkbenchMinimapItemStyle"
               BasedOn="{StaticResource WorkflowWorkbench.MinimapItemStyle}"
               TargetType="{x:Type nodify:MinimapItem}">
            <Setter Property="Location" Value="{Binding Location}" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="150" />
        </Style>

        <DataTemplate x:Key="WorkbenchMinimapNodeTemplate">
            <Border x:Name="MinimapRect" Background="{DynamicResource WorkflowWorkbench.AccentBrush}"
                    CornerRadius="4" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="Source">
                    <Setter TargetName="MinimapRect" Property="Background" Value="#FB923C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Transform">
                    <Setter TargetName="MinimapRect" Property="Background" Value="#FACC15" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Output">
                    <Setter TargetName="MinimapRect" Property="Background" Value="#38BDF8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="OpenCV">
                    <Setter TargetName="MinimapRect" Property="Background" Value="#A78BFA" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DrawingBrush x:Key="WorkbenchCanvasSmallGridBrush"
                      Drawing="{StaticResource WorkflowWorkbench.SmallGridGeometry}"
                      Transform="{Binding ViewportTransform, ElementName=Editor}"
                      TileMode="Tile"
                      Viewport="0 0 24 24"
                      ViewportUnits="Absolute"
                      Opacity="0.5" />

        <DrawingBrush x:Key="WorkbenchCanvasLargeGridBrush"
                      Drawing="{StaticResource WorkflowWorkbench.LargeGridGeometry}"
                      Transform="{Binding ViewportTransform, ElementName=Editor}"
                      TileMode="Tile"
                      Viewport="0 0 120 120"
                      ViewportUnits="Absolute"
                      Opacity="0.7" />
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource WorkflowWorkbench.PageBackgroundBrush}">
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}">
            <WrapPanel>
                <Button Content="执行全部" Command="{Binding ExecuteAllCommand}" Padding="12,4" />
                <Button Content="重置" Command="{Binding ResetCommand}" Padding="12,4" Margin="8,0,0,0" />
                <Button Content="撤销" Command="{Binding UndoCommand}" Padding="10,4" Margin="8,0,0,0" />
                <Button Content="重做" Command="{Binding RedoCommand}" Padding="10,4" Margin="4,0,0,0" />
                <Button Content="删除选中" Command="{Binding DeleteSelectionCommand}" Padding="10,4" Margin="8,0,0,0" />
                <Button Content="全图适配" Command="{Binding FitGraphCommand}" Padding="10,4" Margin="8,0,0,0" />
                <Button Content="重置视口" Command="{Binding ResetViewportCommand}" Padding="10,4" Margin="8,0,0,0" />
                <Button Content="继续执行" Command="{Binding ResumeCommand}" Padding="10,4" Margin="8,0,0,0" />
                <Button Content="切换选中断点" Command="{Binding ToggleBreakpointCommand}" Padding="10,4" Margin="8,0,0,0" />
                <Button Content="返回上级" Command="{Binding NavigateBackCommand}" Padding="12,4" Margin="8,0,0,0" />
                <Button Content="+ 输入" Command="{Binding AddNodeCommand}" CommandParameter="demo.node.text-source" Padding="8,4" Margin="16,0,0,0" />
                <Button Content="+ 转换" Command="{Binding AddNodeCommand}" CommandParameter="demo.node.uppercase-transform" Padding="8,4" Margin="8,0,0,0" />
                <Button Content="+ 预览" Command="{Binding AddNodeCommand}" CommandParameter="demo.node.preview" Padding="8,4" Margin="8,0,0,0" />
                <Button Content="打包选中" Command="{Binding PackSelectedCommand}" Padding="8,4" Margin="8,0,0,0" />
                <Button Content="拆开选中" Command="{Binding UnpackSelectedCommand}" Padding="8,4" Margin="8,0,0,0" />
                <Button Content="编辑变量映射" Click="OnEditVariableMappingsClicked" Padding="8,4" Margin="8,0,0,0" />
                <Button Content="编辑节点设置" Click="OnEditNodeSettingsClicked" Padding="8,4" Margin="8,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Margin="20,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource WorkflowWorkbench.TextBrush}" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="250"
                Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                BorderThickness="0,0,1,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <TextBlock Text="节点库" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding AvailableNodes}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding TypeId}"
                                    PreviewMouseLeftButtonDown="OnLibraryNodeMouseDown"
                                    Margin="0,2"
                                    Padding="6,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text=" 扩展" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="入口变量" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding EntryVariables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Name, Mode=OneWay}" Width="110" TextTrimming="CharacterEllipsis" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="120" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="连接" FontWeight="Bold" Margin="0,16,0,0" />
                <ItemsControl ItemsSource="{Binding Connections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="选中节点端口值" FontWeight="Bold" Margin="0,16,0,0" />
                <ItemsControl ItemsSource="{Binding SelectedNode.Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,1">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                <Run Text=": " />
                                <Run Text="{Binding ValuePreview, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding SelectedNode.Outputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,1">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                <Run Text=": " />
                                <Run Text="{Binding ValuePreview, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="选中元节点的变量映射" FontWeight="Bold" Margin="0,16,0,0" />
                <ItemsControl ItemsSource="{Binding SelectedMetaMappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2">
                                <Run Text="{Binding Direction, Mode=OneWay}" />
                                <Run Text=": " />
                                <Run Text="{Binding Source, Mode=OneWay}" />
                                <Run Text=" -> " />
                                <Run Text="{Binding Target, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="执行日志" FontWeight="Bold" Margin="0,16,0,0" />
                <ItemsControl ItemsSource="{Binding ExecutionLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <Rectangle Fill="{StaticResource WorkbenchCanvasLargeGridBrush}" IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource WorkbenchCanvasSmallGridBrush}" IsHitTestVisible="False" />
            <nodify:NodifyEditor x:Name="Editor"
                             AllowDrop="True"
                             InputGestures="{Binding EditorGestures}"
                             DragOver="OnEditorDragOver"
                             Drop="OnEditorDrop"
                             CanSelectMultipleItems="True"
                             CanSelectMultipleConnections="True"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             SelectedItems="{Binding SelectedNodes, Mode=TwoWay}"
                             PendingConnection="{Binding PendingConnection}"
                             ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                             ViewportSize="{Binding ViewportSize, Mode=TwoWay}"
                             ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                             MinViewportZoom="{Binding MinViewportZoom}"
                             MaxViewportZoom="{Binding MaxViewportZoom}"
                             Style="{StaticResource WorkflowWorkbench.EditorStyle}">
            <nodify:NodifyEditor.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
                <KeyBinding Key="A" Command="{Binding SelectAllNodesCommand}" Modifiers="Control" />
                <KeyBinding Key="F" Command="{Binding FitGraphCommand}" Modifiers="Control" />
                <KeyBinding Key="D0" Command="{Binding ResetViewportCommand}" Modifiers="Control" />
                <KeyBinding Key="F5" Command="{Binding ResumeCommand}" />
            </nodify:NodifyEditor.InputBindings>
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style BasedOn="{StaticResource WorkbenchItemContainerStyle}" TargetType="{x:Type nodify:ItemContainer}" />
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ConnectionTemplate>
                <StaticResource ResourceKey="ConnectionTemplate" />
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.PendingConnectionTemplate>
                <StaticResource ResourceKey="PendingConnectionTemplate" />
            </nodify:NodifyEditor.PendingConnectionTemplate>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate>
                    <nodify:Node
                        Header="{Binding}"
                        HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource NodeCardTemplate}"
                        Input="{Binding Inputs}"
                        Output="{Binding Outputs}"
                        MouseDoubleClick="OnNodeMouseDoubleClick"
                        Style="{StaticResource WorkflowWorkbench.NodeStyle}">
                        <nodify:Node.ToolTip>
                            <ToolTip Content="{Binding}" ContentTemplate="{StaticResource NodeToolTipTemplate}"
                                     Placement="Mouse" />
                        </nodify:Node.ToolTip>
                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate>
                                <nodify:NodeInput
                                    Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                    IsConnected="{Binding IsConnected, Mode=OneWay}"
                                    Style="{StaticResource WorkbenchNodeInputStyle}"
                                    ToolTip="{Binding TypeId}" />
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>
                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate>
                                <nodify:NodeOutput
                                    Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                    IsConnected="{Binding IsConnected, Mode=OneWay}"
                                    Style="{StaticResource WorkbenchNodeOutputStyle}"
                                    ToolTip="{Binding TypeId}" />
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>
                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
            </nodify:NodifyEditor>

            <nodify:Minimap
                Width="260"
                Height="170"
                Margin="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                BorderThickness="1"
                ItemsSource="{Binding ItemsSource, ElementName=Editor}"
                ResizeToViewport="True"
                ViewportLocation="{Binding ViewportLocation, ElementName=Editor}"
                ViewportSize="{Binding ViewportSize, ElementName=Editor}">
                <nodify:Minimap.ItemTemplate>
                    <StaticResource ResourceKey="WorkbenchMinimapNodeTemplate" />
                </nodify:Minimap.ItemTemplate>
                <nodify:Minimap.ItemContainerStyle>
                    <StaticResource ResourceKey="WorkbenchMinimapItemStyle" />
                </nodify:Minimap.ItemContainerStyle>
            </nodify:Minimap>
        </Grid>
    </DockPanel>
</UserControl>
