<UserControl x:Class="Workflow.Studio.Workbench.Views.WorkflowWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:viewModels="clr-namespace:Workflow.Studio.Workbench.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1440">
    <Grid Background="#F3F4F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="16"
                Padding="20"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="Workflow Workbench" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#4B5563"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <UniformGrid Grid.Row="1"
                             Margin="0,20,0,0"
                             Columns="2">
                    <Button Height="40"
                            Margin="0,0,8,0"
                            Command="{Binding ExecuteWorkflowCommand}"
                            Content="执行工作流" />
                    <Button Height="40"
                            Margin="8,0,0,0"
                            Command="{Binding ResetWorkflowCommand}"
                            Content="重置状态" />
                </UniformGrid>

                <Border Grid.Row="2"
                        Margin="0,20,0,0"
                        Padding="14"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="节点库" />
                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding AvailableNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:NodeLibraryItemViewModel}">
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            Background="White"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="#4338CA"
                                                           Text="{Binding Category}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="#6B7280"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="72"
                                                    Height="32"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="添加" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,20,0,0"
                        Padding="14"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Global Variables" />
                        <TextBlock Margin="0,8,0,0"
                                   FontFamily="Consolas"
                                   Foreground="#374151"
                                   Text="{Binding GlobalVariablesText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Margin="0,20,0,0"
                        Padding="14"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Nodes" />
                        <ScrollViewer Margin="0,12,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                                        <Border Margin="0,0,0,10"
                                                Padding="12"
                                                Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Title}" />
                                                    <Border DockPanel.Dock="Right"
                                                            Padding="8,2"
                                                            Background="#EEF2FF"
                                                            CornerRadius="999">
                                                        <TextBlock Foreground="#4338CA"
                                                                   Text="{Binding StatusText}" />
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="#6B7280"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Foreground="#4338CA"
                                                           Text="{Binding NodeTypeText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,8,0,0"
                                                           FontFamily="Consolas"
                                                           Foreground="#374151"
                                                           Text="{Binding PreviewText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="0,16,16,16"
                Background="#111827"
                CornerRadius="16">
            <nodify:NodifyEditor ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 PendingConnection="{Binding PendingConnection}"
                                 Background="#111827">
                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="Location"
                                Value="{Binding Location}" />
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>

                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ConnectionViewModel}">
                        <nodify:LineConnection Source="{Binding Source.Anchor}"
                                               Target="{Binding Target.Anchor}"
                                               Stroke="#60A5FA"
                                               StrokeThickness="3" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate DataType="{x:Type viewModels:PendingConnectionViewModel}">
                        <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                                  CompletedCommand="{Binding FinishCommand}"
                                                  AllowOnlyConnectors="True"
                                                  EnablePreview="True"
                                                  EnableSnapping="True" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>

                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Input="{Binding InputPorts}"
                                     Output="{Binding OutputPorts}"
                                     MinWidth="260">
                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                    <nodify:NodeInput Header="{Binding Title}"
                                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                      IsConnected="{Binding IsConnected}"
                                                      ToolTip="{Binding DisplayValue}" />
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>

                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                    <nodify:NodeOutput Header="{Binding Title}"
                                                       Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                       IsConnected="{Binding IsConnected}"
                                                       ToolTip="{Binding DisplayValue}" />
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>

                            <StackPanel Margin="12">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Text="{Binding Category}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#4B5563"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,10,0,0"
                                        Padding="10"
                                        Background="#EEF2FF"
                                        CornerRadius="10">
                                    <TextBlock Foreground="#4338CA"
                                               Text="{Binding NodeTypeText}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,10,0,0"
                                        Padding="10"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Foreground="#6B7280"
                                                   Text="{Binding PortSummary}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontFamily="Consolas"
                                                   Foreground="#111827"
                                                   Text="{Binding PreviewText}"
                                                   TextWrapping="Wrap" />
                                        <Expander Margin="0,10,0,0"
                                                  IsExpanded="True"
                                                  Header="输入端口分组">
                                            <ItemsControl ItemsSource="{Binding InputGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:PortGroupViewModel}">
                                                        <Expander Margin="0,6,0,0"
                                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                            <Expander.Header>
                                                                <DockPanel>
                                                                    <TextBlock FontWeight="SemiBold"
                                                                               Text="{Binding Name}" />
                                                                    <TextBlock DockPanel.Dock="Right"
                                                                               Foreground="#6B7280"
                                                                               Text="{Binding Summary}" />
                                                                </DockPanel>
                                                            </Expander.Header>
                                                            <ItemsControl ItemsSource="{Binding Ports}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                                                        <DockPanel Margin="0,4,0,0">
                                                                            <TextBlock Text="{Binding Title}" />
                                                                            <TextBlock DockPanel.Dock="Right"
                                                                                       Foreground="#6B7280"
                                                                                       Text="{Binding DisplayValue}" />
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        <Expander Margin="0,10,0,0"
                                                  IsExpanded="True"
                                                  Header="输出端口分组">
                                            <ItemsControl ItemsSource="{Binding OutputGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:PortGroupViewModel}">
                                                        <Expander Margin="0,6,0,0"
                                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                            <Expander.Header>
                                                                <DockPanel>
                                                                    <TextBlock FontWeight="SemiBold"
                                                                               Text="{Binding Name}" />
                                                                    <TextBlock DockPanel.Dock="Right"
                                                                               Foreground="#6B7280"
                                                                               Text="{Binding Summary}" />
                                                                </DockPanel>
                                                            </Expander.Header>
                                                            <ItemsControl ItemsSource="{Binding Ports}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                                                        <DockPanel Margin="0,4,0,0">
                                                                            <TextBlock Text="{Binding Title}" />
                                                                            <TextBlock DockPanel.Dock="Right"
                                                                                       Foreground="#6B7280"
                                                                                       Text="{Binding DisplayValue}" />
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>
            </nodify:NodifyEditor>
        </Border>
    </Grid>
</UserControl>
