<UserControl x:Class="Workflow.Studio.Workbench.Views.WorkflowWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Workflow.Studio.Core.Models;assembly=Workflow.Studio.Core"
             xmlns:nodify="clr-namespace:Workflow.Studio.Nodify;assembly=Workflow.Studio.Nodify"
             xmlns:viewModels="clr-namespace:Workflow.Studio.Workbench.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1440">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Workflow.Studio.Theme;component/Themes/WorkflowWorkbench.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WorkbenchItemContainerStyle"
                   TargetType="{x:Type nodify:ItemContainer}"
                   BasedOn="{StaticResource WorkflowWorkbench.ItemContainerStyle}">
                <Setter Property="Location"
                        Value="{Binding Location}" />
            </Style>

            <Style x:Key="WorkbenchPortGroupChipStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource WorkflowWorkbench.TagBorderStyle}">
                <Setter Property="Margin"
                        Value="0 0 6 6" />
                <Setter Property="Background"
                        Value="{StaticResource WorkflowWorkbench.SubtleBackgroundBrush}" />
            </Style>

            <Style x:Key="CanvasNodeIndicatorDotStyle"
                   TargetType="Ellipse">
                <Setter Property="Width"
                        Value="6" />
                <Setter Property="Height"
                        Value="6" />
                <Setter Property="Margin"
                        Value="0 0 4 0" />
                <Setter Property="Fill"
                        Value="#D1D5DB" />
            </Style>

            <DataTemplate x:Key="PortGroupChipTemplate"
                          DataType="{x:Type viewModels:PortGroupViewModel}">
                <Border Style="{StaticResource WorkbenchPortGroupChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                                   Text="{Binding Name}" />
                        <TextBlock Margin="6 0 0 0"
                                   Foreground="{StaticResource WorkflowWorkbench.SubtleTextBrush}"
                                   Text="{Binding Summary}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NodeHeaderTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <DockPanel LastChildFill="True">
                    <Border x:Name="StatusBadge"
                            DockPanel.Dock="Right"
                            Margin="8 0 0 0"
                            Padding="8 3"
                            Background="{StaticResource WorkflowWorkbench.SecondaryAccentBrush}"
                            CornerRadius="999">
                        <TextBlock x:Name="StatusTextBlock"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WorkflowWorkbench.SecondaryAccentTextBrush}"
                                   Text="{Binding StatusText}" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                                   Text="{Binding Title}" />
                        <TextBlock Margin="0 4 0 0"
                                   Foreground="{StaticResource WorkflowWorkbench.SubtleTextBrush}"
                                   Text="{Binding Category}" />
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Ready}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{StaticResource WorkflowWorkbench.SecondaryAccentBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{StaticResource WorkflowWorkbench.SecondaryAccentTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Running}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{StaticResource WorkflowWorkbench.WarningSoftBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{StaticResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Success}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{StaticResource WorkflowWorkbench.SuccessSoftBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{StaticResource WorkflowWorkbench.SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Failed}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{StaticResource WorkflowWorkbench.ErrorSoftBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{StaticResource WorkflowWorkbench.ErrorBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeContentTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <Border x:Name="NodeGlyphContainer"
                        Width="56"
                        Height="56"
                        Background="{StaticResource WorkflowWorkbench.AccentBrush}"
                        CornerRadius="10">
                    <Grid>
                        <!-- TODO: replace with proper icon if available, using text for now -->
                        <TextBlock x:Name="NodeGlyphText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="N" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Category}"
                                 Value="Source">
                        <Setter TargetName="NodeGlyphContainer"
                                Property="Background"
                                Value="#FB923C" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Text"
                                Value="IN" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}"
                                 Value="Transform">
                        <Setter TargetName="NodeGlyphContainer"
                                Property="Background"
                                Value="#FACC15" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Text"
                                Value="FX" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Foreground"
                                Value="#111827" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}"
                                 Value="Output">
                        <Setter TargetName="NodeGlyphContainer"
                                Property="Background"
                                Value="#38BDF8" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Text"
                                Value="OUT" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeFooterTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <Border Margin="0 4 0 0"
                        Padding="8 4"
                        HorizontalAlignment="Center"
                        Background="{StaticResource WorkflowWorkbench.SubtleBackgroundBrush}"
                        BorderBrush="{StaticResource WorkflowWorkbench.PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                        <Ellipse x:Name="NodeStateDot"
                                 Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                        <Ellipse x:Name="NodeOutputDot"
                                 Margin="0"
                                 Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Ready}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{StaticResource WorkflowWorkbench.SecondaryAccentBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="#D1D5DB" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Running}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{StaticResource WorkflowWorkbench.WarningBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="{StaticResource WorkflowWorkbench.WarningSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Success}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{StaticResource WorkflowWorkbench.SuccessBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="{StaticResource WorkflowWorkbench.SuccessSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Failed}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{StaticResource WorkflowWorkbench.ErrorBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="{StaticResource WorkflowWorkbench.ErrorSoftBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeToolTipTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <StackPanel MaxWidth="320">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0 4 0 0"
                               Foreground="{StaticResource WorkflowWorkbench.SubtleTextBrush}"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                    <Border Margin="0 10 0 0"
                            Padding="10"
                            Background="{StaticResource WorkflowWorkbench.AccentSoftBrush}"
                            CornerRadius="10">
                        <TextBlock Foreground="{StaticResource WorkflowWorkbench.AccentBrush}"
                                   Text="{Binding NodeTypeText}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Margin="0 10 0 0"
                               Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                               Text="{Binding PortSummary}" />
                    <TextBlock Margin="0 4 0 0"
                               FontFamily="Consolas"
                               Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                               Text="{Binding PreviewText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ConnectionTemplate"
                          DataType="{x:Type viewModels:ConnectionViewModel}">
                <nodify:LineConnection Style="{StaticResource WorkflowWorkbench.LineConnectionStyle}"
                                       Source="{Binding Source.Anchor}"
                                       Target="{Binding Target.Anchor}" />
            </DataTemplate>

            <DataTemplate x:Key="PendingConnectionTemplate"
                          DataType="{x:Type viewModels:PendingConnectionViewModel}">
                <nodify:PendingConnection Style="{StaticResource WorkflowWorkbench.PendingConnectionStyle}"
                                          StartedCommand="{Binding StartCommand}"
                                          CompletedCommand="{Binding FinishCommand}"
                                          AllowOnlyConnectors="True"
                                          EnablePreview="True"
                                          EnableSnapping="True" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource WorkflowWorkbench.PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="16"
                Padding="20"
                Style="{StaticResource WorkflowWorkbench.SidebarCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                               Text="Workflow Workbench" />
                    <TextBlock Margin="0 8 0 0"
                               Foreground="{StaticResource WorkflowWorkbench.SubtleTextBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <UniformGrid Grid.Row="1"
                             Margin="0 20 0 0"
                             Columns="2">
                    <Button Height="40"
                            Margin="0 0 8 0"
                            Padding="16 0"
                            Background="{StaticResource WorkflowWorkbench.AccentBrush}"
                            BorderBrush="{StaticResource WorkflowWorkbench.AccentBrush}"
                            Foreground="White"
                            Command="{Binding ExecuteWorkflowCommand}"
                            Content="执行工作流" />
                    <Button Height="40"
                            Margin="8 0 0 0"
                            Padding="16 0"
                            Background="{StaticResource WorkflowWorkbench.SubtleBackgroundBrush}"
                            BorderBrush="{StaticResource WorkflowWorkbench.PanelBorderBrush}"
                            Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                            Command="{Binding ResetWorkflowCommand}"
                            Content="重置状态" />
                </UniformGrid>

                <Border Grid.Row="2"
                        Margin="0 20 0 0"
                        Padding="14"
                        Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}"
                                   Text="节点库" />
                        <ScrollViewer Margin="0 12 0 0"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailableNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:NodeLibraryItemViewModel}">
                                        <Border Margin="0 0 0 10"
                                                Padding="12"
                                                Style="{StaticResource WorkflowWorkbench.SidebarCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0 4 0 0"
                                                               Foreground="{StaticResource WorkflowWorkbench.AccentBrush}"
                                                               Text="{Binding Category}" />
                                                    <TextBlock Margin="0 4 0 0"
                                                               Foreground="{StaticResource WorkflowWorkbench.SubtleTextBrush}"
                                                               Text="{Binding Description}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Width="72"
                                                        Height="32"
                                                        Margin="12 0 0 0"
                                                        Background="{StaticResource WorkflowWorkbench.AccentSoftBrush}"
                                                        BorderBrush="{StaticResource WorkflowWorkbench.AccentBrush}"
                                                        Foreground="{StaticResource WorkflowWorkbench.AccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="添加" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3"
                        Margin="0 20 0 0"
                        Padding="14"
                        Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}"
                                   Text="Global Variables" />
                        <TextBlock Margin="0 8 0 0"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                                   Text="{Binding GlobalVariablesText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Margin="0 20 0 0"
                        Padding="14"
                        Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}"
                                   Text="Nodes" />
                        <ScrollViewer Margin="0 12 0 0"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                                        <Border Margin="0 0 0 10"
                                                Padding="12"
                                                Style="{StaticResource WorkflowWorkbench.SidebarCardStyle}">
                                            <StackPanel>
                                                <ContentPresenter Content="{Binding}"
                                                                  ContentTemplate="{StaticResource NodeHeaderTemplate}" />
                                                <TextBlock Margin="0 10 0 0"
                                                           Foreground="{StaticResource WorkflowWorkbench.SubtleTextBrush}"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0 10 0 0"
                                                           Foreground="{StaticResource WorkflowWorkbench.AccentBrush}"
                                                           Text="{Binding NodeTypeText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0 10 0 0"
                                                           FontFamily="Consolas"
                                                           Foreground="{StaticResource WorkflowWorkbench.TextBrush}"
                                                           Text="{Binding PreviewText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="0 16 16 16"
                Background="{StaticResource WorkflowWorkbench.CanvasOverlayBrush}"
                CornerRadius="18">
            <Grid ClipToBounds="True">
                <Rectangle Fill="{StaticResource WorkflowWorkbench.CanvasOverlayBrush}" />
                <Rectangle Fill="{StaticResource WorkflowWorkbench.LargeGridBrush}"
                           IsHitTestVisible="False"
                           Opacity="0.55" />
                <Rectangle Fill="{StaticResource WorkflowWorkbench.SmallGridBrush}"
                           IsHitTestVisible="False"
                           Opacity="0.8" />

                <nodify:NodifyEditor Style="{StaticResource WorkflowWorkbench.EditorStyle}"
                                     ItemsSource="{Binding Nodes}"
                                     Connections="{Binding Connections}"
                                     PendingConnection="{Binding PendingConnection}">
                    <nodify:NodifyEditor.InputBindings>
                        <KeyBinding Key="Delete"
                                    Command="{Binding ResetWorkflowCommand}" />
                    </nodify:NodifyEditor.InputBindings>

                    <nodify:NodifyEditor.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:ItemContainer}"
                               BasedOn="{StaticResource WorkbenchItemContainerStyle}" />
                    </nodify:NodifyEditor.ItemContainerStyle>

                    <nodify:NodifyEditor.ConnectionTemplate>
                        <StaticResource ResourceKey="ConnectionTemplate" />
                    </nodify:NodifyEditor.ConnectionTemplate>

                    <nodify:NodifyEditor.PendingConnectionTemplate>
                        <StaticResource ResourceKey="PendingConnectionTemplate" />
                    </nodify:NodifyEditor.PendingConnectionTemplate>

                    <nodify:NodifyEditor.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                            <nodify:Node Style="{StaticResource WorkflowWorkbench.NodeStyle}"
                                         Content="{Binding}"
                                         ContentTemplate="{StaticResource CanvasNodeContentTemplate}"
                                         Footer="{Binding}"
                                         FooterTemplate="{StaticResource CanvasNodeFooterTemplate}"
                                         Input="{Binding InputPorts}"
                                         Output="{Binding OutputPorts}"
                                         ToolTipService.ShowDuration="60000">
                                <nodify:Node.ToolTip>
                                    <ToolTip Content="{Binding}"
                                             ContentTemplate="{StaticResource CanvasNodeToolTipTemplate}"
                                             Placement="Mouse" />
                                </nodify:Node.ToolTip>
                                <nodify:Node.InputConnectorTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                        <nodify:NodeInput Style="{StaticResource WorkflowWorkbench.NodeInputStyle}"
                                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"
                                                          ToolTip="{Binding DisplayValue}" />
                                    </DataTemplate>
                                </nodify:Node.InputConnectorTemplate>

                                <nodify:Node.OutputConnectorTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                        <nodify:NodeOutput Style="{StaticResource WorkflowWorkbench.NodeOutputStyle}"
                                                           Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                           IsConnected="{Binding IsConnected}"
                                                           ToolTip="{Binding DisplayValue}" />
                                    </DataTemplate>
                                </nodify:Node.OutputConnectorTemplate>
                            </nodify:Node>
                        </DataTemplate>
                    </nodify:NodifyEditor.ItemTemplate>
                </nodify:NodifyEditor>

                <Border Margin="20"
                        Padding="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#CC0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="14"
                        IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WorkflowWorkbench.CanvasTextBrush}"
                                   Text="Graph Editor" />
                        <TextBlock Margin="0 6 0 0"
                                   Foreground="#CBD5E1"
                                   Text="拖拽节点调整布局，拖动连接点创建连线。" />
                        <TextBlock Margin="0 4 0 0"
                                   Foreground="#94A3B8"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
