<UserControl x:Class="Workflow.Studio.Workbench.Views.WorkflowWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Workflow.Studio.Core.Models;assembly=Workflow.Studio.Core"
             xmlns:nodify="clr-namespace:Workflow.Studio.Nodify;assembly=Workflow.Studio.Nodify"
             xmlns:viewModels="clr-namespace:Workflow.Studio.Workbench.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1440">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="WorkbenchItemContainerStyle"
                   TargetType="{x:Type nodify:ItemContainer}"
                   BasedOn="{StaticResource WorkflowWorkbench.ItemContainerStyle}">
                <Setter Property="Location"
                        Value="{Binding Location}" />
            </Style>

            <Style x:Key="WorkbenchPortGroupChipStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource WorkflowWorkbench.TagBorderStyle}">
                <Setter Property="Margin"
                        Value="0 0 6 6" />
                <Setter Property="Background"
                        Value="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}" />
            </Style>

            <Style x:Key="CanvasNodeIndicatorDotStyle"
                   TargetType="Ellipse">
                <Setter Property="Width"
                        Value="6" />
                <Setter Property="Height"
                        Value="6" />
                <Setter Property="Margin"
                        Value="0 0 4 0" />
                <Setter Property="Fill"
                        Value="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}" />
            </Style>

            <Style x:Key="WorkbenchToolbarButtonStyle"
                   TargetType="Button">
                <Setter Property="Height"
                        Value="40" />
                <Setter Property="Margin"
                        Value="0 0 12 0" />
                <Setter Property="Padding"
                        Value="16 0" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="Foreground"
                        Value="{DynamicResource WorkflowWorkbench.TextBrush}" />
                <Setter Property="Background"
                        Value="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource WorkflowWorkbench.PanelBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled"
                             Value="False">
                        <Setter Property="Opacity"
                                Value="0.55" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorkbenchPrimaryToolbarButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource WorkbenchToolbarButtonStyle}">
                <Setter Property="Foreground"
                        Value="White" />
                <Setter Property="Background"
                        Value="{DynamicResource WorkflowWorkbench.AccentBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource WorkflowWorkbench.AccentBrush}" />
            </Style>

            <Style x:Key="WorkbenchStatusBadgeStyle"
                   TargetType="Border">
                <Setter Property="Padding"
                        Value="10 5" />
                <Setter Property="CornerRadius"
                        Value="999" />
                <Setter Property="Background"
                        Value="{DynamicResource WorkflowWorkbench.SecondaryAccentBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource WorkflowWorkbench.WarningSoftBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorkbenchStatusTextStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="Foreground"
                        Value="{DynamicResource WorkflowWorkbench.SecondaryAccentTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="Foreground"
                                Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="PortGroupChipTemplate"
                          DataType="{x:Type viewModels:PortGroupViewModel}">
                <Border Style="{StaticResource WorkbenchPortGroupChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                   Text="{Binding Name}" />
                        <TextBlock Margin="6 0 0 0"
                                   Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                   Text="{Binding Summary}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NodeHeaderTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <DockPanel LastChildFill="True">
                    <Border x:Name="StatusBadge"
                            DockPanel.Dock="Right"
                            Margin="8 0 0 0"
                            Padding="8 3"
                            Background="{DynamicResource WorkflowWorkbench.SecondaryAccentBrush}"
                            CornerRadius="999">
                        <TextBlock x:Name="StatusTextBlock"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WorkflowWorkbench.SecondaryAccentTextBrush}"
                                   Text="{Binding StatusText}" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                   Text="{Binding Title}" />
                        <TextBlock Margin="0 4 0 0"
                                   Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                   Text="{Binding Category}" />
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Ready}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{DynamicResource WorkflowWorkbench.SecondaryAccentBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{DynamicResource WorkflowWorkbench.SecondaryAccentTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Running}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{DynamicResource WorkflowWorkbench.WarningSoftBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Success}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{DynamicResource WorkflowWorkbench.SuccessSoftBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{DynamicResource WorkflowWorkbench.SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Failed}">
                        <Setter TargetName="StatusBadge"
                                Property="Background"
                                Value="{DynamicResource WorkflowWorkbench.ErrorSoftBrush}" />
                        <Setter TargetName="StatusTextBlock"
                                Property="Foreground"
                                Value="{DynamicResource WorkflowWorkbench.ErrorBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeContentTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <Border x:Name="NodeGlyphContainer"
                        Width="56"
                        Height="56"
                        Background="{DynamicResource WorkflowWorkbench.AccentBrush}"
                        CornerRadius="10">
                    <Grid>
                        <!-- TODO: replace with proper icon if available, using text for now -->
                        <TextBlock x:Name="NodeGlyphText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="N" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Category}"
                                 Value="Source">
                        <Setter TargetName="NodeGlyphContainer"
                                Property="Background"
                                Value="#FB923C" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Text"
                                Value="IN" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}"
                                 Value="Transform">
                        <Setter TargetName="NodeGlyphContainer"
                                Property="Background"
                                Value="#FACC15" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Text"
                                Value="FX" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Foreground"
                                Value="#111827" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}"
                                 Value="Output">
                        <Setter TargetName="NodeGlyphContainer"
                                Property="Background"
                                Value="#38BDF8" />
                        <Setter TargetName="NodeGlyphText"
                                Property="Text"
                                Value="OUT" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeFooterTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <Border Margin="0 4 0 0"
                        Padding="8 4"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}"
                        BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                        <Ellipse x:Name="NodeStateDot"
                                 Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                        <Ellipse x:Name="NodeOutputDot"
                                 Margin="0"
                                 Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Ready}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.SecondaryAccentBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Running}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.WarningSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Success}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.SuccessBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.SuccessSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}"
                                 Value="{x:Static models:NodeStatus.Failed}">
                        <Setter TargetName="NodeStateDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.ErrorBrush}" />
                        <Setter TargetName="NodeOutputDot"
                                Property="Fill"
                                Value="{DynamicResource WorkflowWorkbench.ErrorSoftBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeToolTipTemplate"
                          DataType="{x:Type viewModels:NodeViewModel}">
                <StackPanel MaxWidth="320">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0 4 0 0"
                               Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                    <Border Margin="0 10 0 0"
                            Padding="10"
                            Background="{DynamicResource WorkflowWorkbench.AccentSoftBrush}"
                            CornerRadius="10">
                        <TextBlock Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}"
                                   Text="{Binding NodeTypeText}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Margin="0 10 0 0"
                               Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                               Text="{Binding PortSummary}" />
                    <TextBlock Margin="0 8 0 0"
                               Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                               Text="{Binding SettingsCount, StringFormat=设置项: {0}}" />
                    <TextBlock Margin="0 4 0 0"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                               Text="{Binding SettingsSummary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0 8 0 0"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                               Text="{Binding PreviewText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ConnectionTemplate"
                          DataType="{x:Type viewModels:ConnectionViewModel}">
                <nodify:LineConnection Style="{StaticResource WorkflowWorkbench.LineConnectionStyle}"
                                       Source="{Binding Source.Anchor}"
                                       Target="{Binding Target.Anchor}" />
            </DataTemplate>

            <DataTemplate x:Key="PendingConnectionTemplate"
                          DataType="{x:Type viewModels:PendingConnectionViewModel}">
                <nodify:PendingConnection Style="{StaticResource WorkflowWorkbench.PendingConnectionStyle}"
                                          StartedCommand="{Binding StartCommand}"
                                          CompletedCommand="{Binding FinishCommand}"
                                          AllowOnlyConnectors="True"
                                          EnablePreview="True"
                                          EnableSnapping="True" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WorkflowWorkbench.PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="16 16 16 0"
                Padding="12 10"
                Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}"
                BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource WorkbenchPrimaryToolbarButtonStyle}"
                            Command="{Binding ExecuteWorkflowCommand}"
                            Content="执行工作流" />
                    <Button Style="{StaticResource WorkbenchToolbarButtonStyle}"
                            Margin="0"
                            Command="{Binding ResetWorkflowCommand}"
                            Content="重置状态" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="24 0 0 0"
                            VerticalAlignment="Center">
                    <Border Padding="10 4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource WorkflowWorkbench.AccentSoftBrush}"
                            CornerRadius="999">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}"
                                   Text="工作流控制台" />
                    </Border>
                    <TextBlock Margin="0 8 0 0"
                               Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                               Text="在顶部快速执行工作流、重置状态，并实时查看当前图状态。" />
                </StackPanel>

                <Button Grid.Column="2"
                        Margin="0 0 12 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource WorkbenchToolbarButtonStyle}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="{Binding CurrentThemeText, StringFormat=切换主题，当前：{0}}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter Margin="0 0 8 0"
                                          Content="{StaticResource ThemeIcon}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding CurrentThemeText}" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource WorkbenchStatusBadgeStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0 0 8 0"
                                       Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                       Text="运行状态" />
                            <TextBlock Style="{StaticResource WorkbenchStatusTextStyle}"
                                       Text="{Binding WorkflowStateText}" />
                            <TextBlock Margin="8 0 0 0"
                                       Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                       Text="{Binding WorkflowGraphSummary}" />
                        </StackPanel>
                        <TextBlock Margin="0 4 0 0"
                                   Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"
                                  MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Margin="16"
                    Padding="20"
                    Style="{StaticResource WorkflowWorkbench.SidebarCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="220" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0 0 0 20"
                            Padding="14"
                            Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}"
                                       Text="节点库" />
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0 8 0 0"
                                       Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                       Text="拖拽方块到右侧画布即可创建节点。" />
                            <ScrollViewer Margin="0 12 0 0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:NodeLibraryItemViewModel}">
                                            <Border Width="70"
                                                    Height="70"
                                                    Margin="0 0 6 6"
                                                    Padding="6"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="LibraryNode_PreviewMouseLeftButtonDown"
                                                    MouseLeftButtonUp="LibraryNode_PreviewMouseLeftButtonUp"
                                                    MouseMove="LibraryNode_PreviewMouseMove"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Style="{StaticResource WorkflowWorkbench.SidebarCardStyle}"
                                                    ToolTip="{Binding Description}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Width="24"
                                                            Height="24"
                                                            HorizontalAlignment="Center"
                                                            Background="{DynamicResource WorkflowWorkbench.AccentSoftBrush}"
                                                            CornerRadius="8">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="8"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}"
                                                                   Text="N" />
                                                    </Border>
                                                    <TextBlock Grid.Row="1"
                                                               Margin="0 6 0 0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="26" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1"
                                  Margin="0 12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True" />

                    <Border Grid.Row="2"
                            Margin="0 20 0 0"
                            Padding="14"
                            Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}"
                                       Text="Global Variables" />
                            <ScrollViewer Margin="0 8 0 0"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock FontFamily="Consolas"
                                           Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                           Text="{Binding GlobalVariablesText}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Margin="0 16"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Margin="0 16 16 16"
                    Background="{DynamicResource WorkflowWorkbench.CanvasOverlayBrush}"
                    CornerRadius="18">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource WorkflowWorkbench.CanvasOverlayBrush}" />
                    <Rectangle Fill="{DynamicResource WorkflowWorkbench.LargeGridBrush}"
                               IsHitTestVisible="False"
                               Opacity="0.55" />
                    <Rectangle Fill="{DynamicResource WorkflowWorkbench.SmallGridBrush}"
                               IsHitTestVisible="False"
                               Opacity="0.8" />

                    <nodify:NodifyEditor x:Name="Editor"
                                         AllowDrop="True"
                                         DragOver="Editor_DragOver"
                                         Drop="Editor_Drop"
                                         Style="{StaticResource WorkflowWorkbench.EditorStyle}"
                                         ItemsSource="{Binding Nodes}"
                                         Connections="{Binding Connections}"
                                         PendingConnection="{Binding PendingConnection}">
                        <nodify:NodifyEditor.InputBindings>
                            <KeyBinding Key="Delete"
                                        Command="{Binding ResetWorkflowCommand}" />
                        </nodify:NodifyEditor.InputBindings>

                        <nodify:NodifyEditor.ItemContainerStyle>
                            <Style TargetType="{x:Type nodify:ItemContainer}"
                                   BasedOn="{StaticResource WorkbenchItemContainerStyle}" />
                        </nodify:NodifyEditor.ItemContainerStyle>

                        <nodify:NodifyEditor.ConnectionTemplate>
                            <StaticResource ResourceKey="ConnectionTemplate" />
                        </nodify:NodifyEditor.ConnectionTemplate>

                        <nodify:NodifyEditor.PendingConnectionTemplate>
                            <StaticResource ResourceKey="PendingConnectionTemplate" />
                        </nodify:NodifyEditor.PendingConnectionTemplate>

                        <nodify:NodifyEditor.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                                <nodify:Node Style="{StaticResource WorkflowWorkbench.NodeStyle}"
                                             Content="{Binding}"
                                             ContentTemplate="{StaticResource CanvasNodeContentTemplate}"
                                             Footer="{Binding}"
                                             FooterTemplate="{StaticResource CanvasNodeFooterTemplate}"
                                             Input="{Binding InputPorts}"
                                             Output="{Binding OutputPorts}"
                                             MouseDoubleClick="Node_MouseDoubleClick"
                                             ToolTipService.ShowDuration="60000">
                                    <nodify:Node.ToolTip>
                                        <ToolTip Content="{Binding}"
                                                 ContentTemplate="{StaticResource CanvasNodeToolTipTemplate}"
                                                 Placement="Mouse" />
                                    </nodify:Node.ToolTip>
                                    <nodify:Node.InputConnectorTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                            <nodify:NodeInput Style="{StaticResource WorkflowWorkbench.NodeInputStyle}"
                                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                              IsConnected="{Binding IsConnected}"
                                                              ToolTip="{Binding DisplayValue}" />
                                        </DataTemplate>
                                    </nodify:Node.InputConnectorTemplate>

                                    <nodify:Node.OutputConnectorTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                            <nodify:NodeOutput Style="{StaticResource WorkflowWorkbench.NodeOutputStyle}"
                                                               Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                               IsConnected="{Binding IsConnected}"
                                                               ToolTip="{Binding DisplayValue}" />
                                        </DataTemplate>
                                    </nodify:Node.OutputConnectorTemplate>
                                </nodify:Node>
                            </DataTemplate>
                        </nodify:NodifyEditor.ItemTemplate>
                    </nodify:NodifyEditor>

                    <Border Margin="20"
                            Padding="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource WorkflowWorkbench.CanvasCalloutBackgroundBrush}"
                            BorderBrush="{DynamicResource WorkflowWorkbench.CanvasCalloutBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WorkflowWorkbench.CanvasTextBrush}"
                                       Text="Graph Editor" />
                            <TextBlock Margin="0 6 0 0"
                                       Foreground="{DynamicResource WorkflowWorkbench.CanvasCalloutSecondaryTextBrush}"
                                       Text="拖拽节点调整布局，拖动连接点创建连线，双击节点编辑设置。" />
                            <TextBlock Margin="0 4 0 0"
                                       Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
