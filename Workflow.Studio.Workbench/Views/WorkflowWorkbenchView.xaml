<UserControl
    x:Class="Workflow.Studio.Workbench.Views.WorkflowWorkbenchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Workflow.Studio.Core.Models;assembly=Workflow.Studio.Core"
    xmlns:nodify="clr-namespace:Workflow.Studio.Nodify;assembly=Workflow.Studio.Nodify"
    xmlns:viewModels="clr-namespace:Workflow.Studio.Workbench.ViewModels"
    d:DesignHeight="900"
    d:DesignWidth="1440"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style
                x:Key="WorkbenchItemContainerStyle"
                BasedOn="{StaticResource WorkflowWorkbench.ItemContainerStyle}"
                TargetType="{x:Type nodify:ItemContainer}">
                <Setter Property="Location" Value="{Binding Location}" />
            </Style>

            <Style
                x:Key="WorkbenchPortGroupChipStyle"
                BasedOn="{StaticResource WorkflowWorkbench.TagBorderStyle}"
                TargetType="Border">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}" />
            </Style>

            <Style x:Key="CanvasNodeIndicatorDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Fill" Value="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}" />
            </Style>

            <Style x:Key="WorkbenchToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.PanelBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style
                x:Key="WorkbenchPrimaryToolbarButtonStyle"
                BasedOn="{StaticResource WorkbenchToolbarButtonStyle}"
                TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.AccentBrush}" />
            </Style>

            <Style x:Key="WorkbenchStatusBadgeStyle" TargetType="Border">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.SecondaryAccentBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.WarningSoftBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WorkbenchStatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.SecondaryAccentTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ExecutionLogRowStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LevelText}" Value="WARNING">
                        <Setter Property="Background" Value="#14F59E0B" />
                        <Setter Property="BorderBrush" Value="#66F59E0B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelText}" Value="ERROR">
                        <Setter Property="Background" Value="#14EF4444" />
                        <Setter Property="BorderBrush" Value="#66EF4444" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ExecutionLogMessageTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.TextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LevelText}" Value="WARNING">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelText}" Value="ERROR">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.ErrorBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DrawingBrush
                x:Key="CanvasSmallGridBrush"
                Drawing="{StaticResource WorkflowWorkbench.SmallGridGeometry}"
                TileMode="Tile"
                Transform="{Binding ViewportTransform, ElementName=Editor}"
                Viewport="0 0 24 24"
                ViewportUnits="Absolute" />

            <DrawingBrush
                x:Key="CanvasLargeGridBrush"
                Drawing="{StaticResource WorkflowWorkbench.LargeGridGeometry}"
                Opacity="0.6"
                TileMode="Tile"
                Transform="{Binding ViewportTransform, ElementName=Editor}"
                Viewport="0 0 120 120"
                ViewportUnits="Absolute" />

            <Style x:Key="WorkbenchMinimapViewportStyle" TargetType="Rectangle">
                <Setter Property="Stroke" Value="{DynamicResource WorkflowWorkbench.AccentBrush}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="RadiusX" Value="8" />
                <Setter Property="RadiusY" Value="8" />
                <Setter Property="Fill">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.18" Color="{StaticResource WorkflowWorkbench.AccentColor}" />
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="WorkbenchMinimapNodeTemplate" DataType="{x:Type viewModels:NodeViewModel}">
                <Grid>
                    <Border
                        x:Name="MinimapNodeAccent"
                        Height="18"
                        Margin="10,10,10,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource WorkflowWorkbench.AccentBrush}"
                        CornerRadius="3" />
                    <Border
                        Height="10"
                        Margin="10,38,10,0"
                        VerticalAlignment="Top"
                        Background="#33FFFFFF"
                        CornerRadius="2" />
                    <Border
                        Height="8"
                        Margin="10,56,34,0"
                        VerticalAlignment="Top"
                        Background="#24FFFFFF"
                        CornerRadius="2" />
                    <Border
                        Height="8"
                        Margin="10,70,64,0"
                        VerticalAlignment="Top"
                        Background="#1AFFFFFF"
                        CornerRadius="2" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Category}" Value="Source">
                        <Setter TargetName="MinimapNodeAccent" Property="Background" Value="#FB923C" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Transform">
                        <Setter TargetName="MinimapNodeAccent" Property="Background" Value="#FACC15" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Output">
                        <Setter TargetName="MinimapNodeAccent" Property="Background" Value="#38BDF8" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style
                x:Key="WorkbenchMinimapItemStyle"
                BasedOn="{StaticResource WorkflowWorkbench.MinimapItemStyle}"
                TargetType="{x:Type nodify:MinimapItem}">
                <Setter Property="Location" Value="{Binding Location}" />
                <Setter Property="Width" Value="200" />
                <Setter Property="Height" Value="140" />
                <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Opacity" Value="0.96" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Paused}">
                        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.SecondaryAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Ready}">
                        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Running}">
                        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Success}">
                        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Failed}">
                        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.ErrorBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="PortGroupChipTemplate" DataType="{x:Type viewModels:PortGroupViewModel}">
                <Border Style="{StaticResource WorkbenchPortGroupChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                            Text="{Binding Name}" />
                        <TextBlock
                            Margin="6,0,0,0"
                            Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                            Text="{Binding Summary}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NodeHeaderTemplate" DataType="{x:Type viewModels:NodeViewModel}">
                <StackPanel>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                        Text="{Binding Category}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeContentTemplate" DataType="{x:Type viewModels:NodeViewModel}">
                <StackPanel>

                    <Border
                        x:Name="NodeGlyphContainer"
                        Width="42"
                        Height="42"
                        Background="{DynamicResource WorkflowWorkbench.AccentBrush}"
                        CornerRadius="10">
                        <Grid>
                            <!--  TODO: replace with proper icon if available, using text for now  -->
                            <TextBlock
                                x:Name="NodeGlyphText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="N" />
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <StackPanel
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Ellipse
                                x:Name="NodeFailedDot"
                                Fill="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}"
                                Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                            <Ellipse
                                x:Name="NodeReadyDot"
                                Fill="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}"
                                Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                            <Ellipse
                                x:Name="NodeSuccessDot"
                                Margin="0"
                                Fill="{DynamicResource WorkflowWorkbench.NodeIndicatorMutedBrush}"
                                Style="{StaticResource CanvasNodeIndicatorDotStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Category}" Value="Source">
                        <Setter TargetName="NodeGlyphContainer" Property="Background" Value="#FB923C" />
                        <Setter TargetName="NodeGlyphText" Property="Text" Value="IN" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Transform">
                        <Setter TargetName="NodeGlyphContainer" Property="Background" Value="#FACC15" />
                        <Setter TargetName="NodeGlyphText" Property="Text" Value="FX" />
                        <Setter TargetName="NodeGlyphText" Property="Foreground" Value="#111827" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Output">
                        <Setter TargetName="NodeGlyphContainer" Property="Background" Value="#38BDF8" />
                        <Setter TargetName="NodeGlyphText" Property="Text" Value="OUT" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Ready}">
                        <Setter TargetName="NodeReadyDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Running}">
                        <Setter TargetName="NodeReadyDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Success}">
                        <Setter TargetName="NodeSuccessDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:NodeStatus.Failed}">
                        <Setter TargetName="NodeFailedDot" Property="Fill" Value="{DynamicResource WorkflowWorkbench.ErrorBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="CanvasNodeToolTipTemplate" DataType="{x:Type viewModels:NodeViewModel}">
                <StackPanel MaxWidth="320">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="{DynamicResource WorkflowWorkbench.AccentSoftBrush}"
                        CornerRadius="10">
                        <TextBlock
                            Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}"
                            Text="{Binding NodeTypeText}"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                        Text="{Binding PortSummary}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                        Text="{Binding SettingsCount, StringFormat=设置项: {0}}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="Consolas"
                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                        Text="{Binding SettingsSummary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontFamily="Consolas"
                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                        Text="{Binding PreviewText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                        Text="输入端口" />
                    <ItemsControl ItemsSource="{Binding InputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                <Border
                                    Margin="0,4,0,0"
                                    Padding="8,6"
                                    Background="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}"
                                    CornerRadius="10">
                                    <DockPanel LastChildFill="True">
                                        <Border
                                            Padding="8,2"
                                            Background="{Binding SemanticBadgeBackground}"
                                            CornerRadius="999"
                                            DockPanel.Dock="Right">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding SemanticBadgeForeground}"
                                                Text="{Binding SemanticBadgeText}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                                                Text="{Binding TypeDisplayText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                        Text="输出端口" />
                    <ItemsControl ItemsSource="{Binding OutputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                <Border
                                    Margin="0,4,0,0"
                                    Padding="8,6"
                                    Background="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}"
                                    CornerRadius="10">
                                    <DockPanel LastChildFill="True">
                                        <Border
                                            Padding="8,2"
                                            Background="{Binding SemanticBadgeBackground}"
                                            CornerRadius="999"
                                            DockPanel.Dock="Right">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding SemanticBadgeForeground}"
                                                Text="{Binding SemanticBadgeText}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Style="{StaticResource WorkflowWorkbench.CaptionTextStyle}"
                                                Text="{Binding TypeDisplayText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ConnectionTemplate" DataType="{x:Type viewModels:ConnectionViewModel}">
                <nodify:LineConnection
                    Source="{Binding Source.Anchor}"
                    Style="{StaticResource WorkflowWorkbench.LineConnectionStyle}"
                    Target="{Binding Target.Anchor}" />
            </DataTemplate>

            <DataTemplate x:Key="PendingConnectionTemplate" DataType="{x:Type viewModels:PendingConnectionViewModel}">
                <nodify:PendingConnection
                    AllowOnlyConnectors="True"
                    CompletedCommand="{Binding FinishCommand}"
                    EnablePreview="True"
                    EnableSnapping="True"
                    StartedCommand="{Binding StartCommand}"
                    Style="{StaticResource WorkflowWorkbench.PendingConnectionStyle}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WorkflowWorkbench.PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="16,16,16,0"
            Padding="12,10"
            Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}"
            BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ExecuteWorkflowCommand}"
                        Content="执行工作流"
                        Style="{StaticResource WorkbenchPrimaryToolbarButtonStyle}" />
                    <Button
                        Margin="0"
                        Command="{Binding ResetWorkflowCommand}"
                        Content="重置状态"
                        Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                    <Button
                        Command="{Binding SaveWorkflowCommand}"
                        Content="保存工作流"
                        Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                    <Button
                        Margin="0"
                        Command="{Binding LoadWorkflowCommand}"
                        Content="加载工作流"
                        Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                    <Button
                        Command="{Binding ResumeExecutionCommand}"
                        Content="继续执行"
                        Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center">
                    <Border
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource WorkflowWorkbench.AccentSoftBrush}"
                        CornerRadius="999">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}"
                            Text="工作流控制台" />
                    </Border>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                        Text="在顶部快速执行工作流、重置状态，并实时查看当前图状态。" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                        Text="{Binding WorkflowDocumentText}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleThemeCommand}"
                    Style="{StaticResource WorkbenchToolbarButtonStyle}"
                    ToolTip="{Binding CurrentThemeText, StringFormat=切换主题，当前：{0}}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter Margin="0,0,8,0" Content="{StaticResource ThemeIcon}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Text="{Binding CurrentThemeText}" />
                    </StackPanel>
                </Button>

                <Border
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource WorkbenchStatusBadgeStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                Text="运行状态" />
                            <TextBlock Style="{StaticResource WorkbenchStatusTextStyle}" Text="{Binding WorkflowStateText}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                Text="{Binding WorkflowGraphSummary}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource WorkflowWorkbench.WarningBrush}"
                            Text="{Binding DebugStateText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="16"
                Padding="20"
                Style="{StaticResource WorkflowWorkbench.SidebarCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="220" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,20"
                        Padding="14"
                        Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}"
                                Text="节点库" />
                            <TextBlock
                                Margin="0,8,0,0"
                                DockPanel.Dock="Top"
                                Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                Text="拖拽方块到右侧画布即可创建节点。" />
                            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:NodeLibraryItemViewModel}">
                                            <Border
                                                Width="70"
                                                Height="70"
                                                Margin="0,0,6,6"
                                                Padding="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="LibraryNode_PreviewMouseLeftButtonDown"
                                                MouseLeftButtonUp="LibraryNode_PreviewMouseLeftButtonUp"
                                                MouseMove="LibraryNode_PreviewMouseMove"
                                                Style="{StaticResource WorkflowWorkbench.SidebarCardStyle}"
                                                ToolTip="{Binding Description}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border
                                                        Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource WorkflowWorkbench.AccentSoftBrush}"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="8"
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource WorkflowWorkbench.AccentBrush}"
                                                            Text="N" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        MaxHeight="26"
                                                        Margin="0,6,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                                        Text="{Binding DisplayName}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <GridSplitter
                        Grid.Row="1"
                        Margin="0,12"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Rows"
                        ShowsPreview="True" />

                    <Border
                        Grid.Row="2"
                        Margin="0,20,0,0"
                        Padding="14"
                        Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                DockPanel.Dock="Top"
                                Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}"
                                Text="Global Variables" />
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    FontFamily="Consolas"
                                    Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                    Text="{Binding GlobalVariablesText}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Margin="0,16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                ShowsPreview="True" />

            <Grid Grid.Column="2" Margin="0,16,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*" MinHeight="320" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="2*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Background="{DynamicResource WorkflowWorkbench.CanvasOverlayBrush}"
                    CornerRadius="18">
                    <Grid ClipToBounds="True">
                        <Rectangle Fill="{DynamicResource WorkflowWorkbench.CanvasOverlayBrush}" />
                        <Rectangle
                            Fill="{StaticResource CanvasLargeGridBrush}"
                            IsHitTestVisible="False"
                            Opacity="0.55" />
                        <Rectangle
                            Fill="{StaticResource CanvasSmallGridBrush}"
                            IsHitTestVisible="False"
                            Opacity="0.8" />

                        <nodify:NodifyEditor
                            x:Name="Editor"
                            AllowDrop="True"
                            CanSelectMultipleConnections="True"
                            CanSelectMultipleItems="True"
                            Connections="{Binding Connections}"
                            DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                            DragOver="Editor_DragOver"
                            Drop="Editor_Drop"
                            EnableRealtimeSelection="True"
                            ItemsSource="{Binding Nodes}"
                            MaxViewportZoom="{Binding MaxViewportZoom}"
                            MinViewportZoom="{Binding MinViewportZoom}"
                            PendingConnection="{Binding PendingConnection}"
                            SelectedConnection="{Binding SelectedConnection}"
                            SelectedConnections="{Binding SelectedConnections}"
                            SelectedItem="{Binding SelectedNode}"
                            SelectedItems="{Binding SelectedNodes}"
                            Style="{StaticResource WorkflowWorkbench.EditorStyle}"
                            ViewportLocation="{Binding ViewportLocation}"
                            ViewportSize="{Binding ViewportSize, Mode=OneWayToSource}"
                            ViewportZoom="{Binding ViewportZoom}">
                            <nodify:NodifyEditor.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
                                <KeyBinding
                                    Key="A"
                                    Command="{Binding SelectAllNodesCommand}"
                                    Modifiers="Control" />
                                <KeyBinding
                                    Key="B"
                                    Command="{Binding ToggleBreakpointCommand}"
                                    Modifiers="Control" />
                                <KeyBinding
                                    Key="F"
                                    Command="{Binding FitGraphCommand}"
                                    Modifiers="Control" />
                                <KeyBinding
                                    Key="F"
                                    Command="{Binding FitSelectionCommand}"
                                    Modifiers="Control+Shift" />
                                <KeyBinding
                                    Key="D0"
                                    Command="{Binding ResetViewportCommand}"
                                    Modifiers="Control" />
                                <KeyBinding Key="F5" Command="{Binding ResumeExecutionCommand}" />
                            </nodify:NodifyEditor.InputBindings>

                            <nodify:NodifyEditor.ItemContainerStyle>
                                <Style BasedOn="{StaticResource WorkbenchItemContainerStyle}" TargetType="{x:Type nodify:ItemContainer}" />
                            </nodify:NodifyEditor.ItemContainerStyle>

                            <nodify:NodifyEditor.ConnectionTemplate>
                                <StaticResource ResourceKey="ConnectionTemplate" />
                            </nodify:NodifyEditor.ConnectionTemplate>

                            <nodify:NodifyEditor.PendingConnectionTemplate>
                                <StaticResource ResourceKey="PendingConnectionTemplate" />
                            </nodify:NodifyEditor.PendingConnectionTemplate>

                            <nodify:NodifyEditor.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                                    <nodify:Node
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource CanvasNodeContentTemplate}"
                                        HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                                        Input="{Binding InputPorts}"
                                        MouseDoubleClick="Node_MouseDoubleClick"
                                        Output="{Binding OutputPorts}"
                                        Style="{StaticResource WorkflowWorkbench.NodeStyle}"
                                        ToolTipService.ShowDuration="60000">
                                        <nodify:Node.ToolTip>
                                            <ToolTip
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource CanvasNodeToolTipTemplate}"
                                                Placement="Mouse" />
                                        </nodify:Node.ToolTip>
                                        <nodify:Node.InputConnectorTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                                <nodify:NodeInput
                                                    Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                    BorderBrush="{Binding SemanticAccentBrush}"
                                                    IsConnected="{Binding IsConnected}"
                                                    Style="{StaticResource WorkflowWorkbench.NodeInputStyle}"
                                                    ToolTip="{Binding ToolTipText}" />
                                            </DataTemplate>
                                        </nodify:Node.InputConnectorTemplate>

                                        <nodify:Node.OutputConnectorTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:PortViewModel}">
                                                <nodify:NodeOutput
                                                    Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                    BorderBrush="{Binding SemanticAccentBrush}"
                                                    IsConnected="{Binding IsConnected}"
                                                    Style="{StaticResource WorkflowWorkbench.NodeOutputStyle}"
                                                    ToolTip="{Binding ToolTipText}" />
                                            </DataTemplate>
                                        </nodify:Node.OutputConnectorTemplate>
                                    </nodify:Node>
                                </DataTemplate>
                            </nodify:NodifyEditor.ItemTemplate>
                        </nodify:NodifyEditor>

                        <nodify:Minimap
                            Width="260"
                            Height="160"
                            Margin="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                            BorderThickness="1"
                            ItemsSource="{Binding ItemsSource, ElementName=Editor}"
                            ResizeToViewport="True"
                            ViewportLocation="{Binding ViewportLocation, ElementName=Editor}"
                            ViewportSize="{Binding ViewportSize, ElementName=Editor}"
                            ViewportStyle="{StaticResource WorkbenchMinimapViewportStyle}">
                            <nodify:Minimap.ItemTemplate>
                                <StaticResource ResourceKey="WorkbenchMinimapNodeTemplate" />
                            </nodify:Minimap.ItemTemplate>
                            <nodify:Minimap.ItemContainerStyle>
                                <StaticResource ResourceKey="WorkbenchMinimapItemStyle" />
                            </nodify:Minimap.ItemContainerStyle>
                        </nodify:Minimap>

                        <Grid
                            Margin="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton
                                x:Name="CanvasCalloutToggle"
                                Padding="14,12"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource WorkflowWorkbench.CanvasCalloutBackgroundBrush}"
                                BorderBrush="{DynamicResource WorkflowWorkbench.CanvasCalloutBorderBrush}"
                                BorderThickness="1"
                                IsChecked="True"
                                ToolTip="展开或收起图编辑器说明">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="HeaderBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="14">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock
                                                    x:Name="IndicatorText"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Right"
                                                    Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                                    Text="展开" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="14,14,0,0" />
                                                <Setter TargetName="IndicatorText" Property="Text" Value="收起" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource WorkflowWorkbench.CanvasTextBrush}"
                                    Text="Graph Editor" />
                            </ToggleButton>

                            <Border
                                Grid.Row="1"
                                Margin="0,-1,0,0"
                                Padding="14,0,14,14"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource WorkflowWorkbench.CanvasCalloutBackgroundBrush}"
                                BorderBrush="{DynamicResource WorkflowWorkbench.CanvasCalloutBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,14,14"
                                IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=CanvasCalloutToggle}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.CanvasCalloutSecondaryTextBrush}"
                                        Text="拖拽节点调整布局，拖动连接点创建连线，Ctrl+拖动已连接输入端口可重定向连线，双击节点编辑设置。" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding ViewportText}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding SelectionText}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="快捷键: Ctrl+A 全选 / Ctrl+B 断点 / Ctrl+F 全图 / Ctrl+Shift+F 适配选中 / Ctrl+0 重置缩放 / F5 继续" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel
                            Width="260"
                            Margin="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <Border
                                Margin="0,0,0,10"
                                Padding="14"
                                Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                        Text="选中连线" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding SelectedConnection.DisplayName, TargetNullValue=当前未选中连线}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RemoveConnectionCommand}"
                                        CommandParameter="{Binding SelectedConnection}"
                                        Content="删除连线"
                                        Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConnection}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Border
                                Padding="14"
                                Background="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                        Text="选中节点" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding SelectedNode.Title, TargetNullValue=当前未选中节点}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding SelectedNode.Location, StringFormat=位置: {0}}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding SelectedNode.PortSummary, StringFormat=端口: {0}}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                        Text="{Binding SelectedNode.DebugStateText, TargetNullValue=调试状态: 无}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                        Text="{Binding SelectedNode.LastMessageText, TargetNullValue=暂无执行消息}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource WorkflowWorkbench.ErrorBrush}"
                                        Text="{Binding SelectedNode.ErrorText, TargetNullValue=无错误}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                        <Button
                                            HorizontalAlignment="Left"
                                            Command="{Binding ToggleBreakpointCommand}"
                                            Content="切换断点"
                                            Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                                        <Button
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding FitSelectionCommand}"
                                            Content="定位选中"
                                            Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                                    </StackPanel>
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RemoveNodeCommand}"
                                        CommandParameter="{Binding SelectedNode}"
                                        Content="删除节点"
                                        Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                                </StackPanel>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter
                    Grid.Row="1"
                    Height="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Rows"
                    ShowsPreview="True"
                    ToolTip="拖动以调整画布与执行日志区域高度" />

                <Border
                    Grid.Row="2"
                    MinHeight="140"
                    Padding="14"
                    Style="{StaticResource WorkflowWorkbench.SurfaceCardStyle}">
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource WorkflowWorkbench.SectionTitleTextStyle}" Text="执行日志" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                    Text="显示最近执行输出，方便在编辑画布时快速查看运行反馈。" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Border
                                    Margin="0,0,10,0"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}"
                                    CornerRadius="999">
                                    <TextBlock Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}" Text="{Binding ExecutionLogSummary}" />
                                </Border>
                                <Button
                                    Height="32"
                                    MinWidth="88"
                                    Padding="12,0"
                                    Command="{Binding ClearExecutionLogCommand}"
                                    Content="清空日志"
                                    Style="{StaticResource WorkbenchToolbarButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="10,8"
                            Background="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}"
                            BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExecutionLogTimeColumn" />
                                    <ColumnDefinition
                                        Width="*"
                                        MinWidth="120"
                                        SharedSizeGroup="ExecutionLogNodeColumn" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExecutionLogLevelColumn" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                    Text="时间" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                    Text="节点" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="0,0,12,0"
                                    Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                    Text="级别" />
                                <TextBlock
                                    Grid.Column="3"
                                    Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                    Text="消息" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <ScrollViewer x:Name="ExecutionLogScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ExecutionLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ExecutionLogItemViewModel}">
                                            <Border Style="{StaticResource ExecutionLogRowStyle}" ToolTip="{Binding Message}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExecutionLogTimeColumn" />
                                                        <ColumnDefinition
                                                            Width="*"
                                                            MinWidth="120"
                                                            SharedSizeGroup="ExecutionLogNodeColumn" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExecutionLogLevelColumn" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}"
                                                        Text="{Binding TimestampText}" />

                                                    <DockPanel
                                                        Grid.Column="1"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        LastChildFill="True">
                                                        <Border
                                                            Width="8"
                                                            Height="8"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="4" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource WorkflowWorkbench.TextBrush}"
                                                            Text="{Binding NodeText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>

                                                    <Border
                                                        Grid.Column="2"
                                                        Margin="0,0,12,0"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding AccentBrush}"
                                                        CornerRadius="999">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding LevelText}" />
                                                    </Border>

                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ExecutionLogMessageTextStyle}"
                                                        Text="{Binding Message}"
                                                        ToolTip="{Binding Message}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border
                                Padding="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource WorkflowWorkbench.PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                IsHitTestVisible="False">
                                <TextBlock Foreground="{DynamicResource WorkflowWorkbench.SubtleTextBrush}" Text="暂无执行日志，运行工作流后将在这里显示最近输出。" />
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExecutionLogs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
