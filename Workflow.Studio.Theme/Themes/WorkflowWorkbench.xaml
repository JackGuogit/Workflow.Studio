<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:studioNodify="clr-namespace:Workflow.Studio.Nodify;assembly=Workflow.Studio.Nodify">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Nodify.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <GeometryDrawing x:Key="WorkflowWorkbench.SmallGridGeometry"
                     Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z"
                     Brush="{DynamicResource GridLinesBrush}" />

    <GeometryDrawing x:Key="WorkflowWorkbench.LargeGridGeometry"
                     Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z"
                     Brush="{DynamicResource GridLinesBrush}" />

    <DrawingBrush x:Key="WorkflowWorkbench.SmallGridBrush"
                  TileMode="Tile"
                  Viewport="0 0 24 24"
                  ViewportUnits="Absolute"
                  Drawing="{StaticResource WorkflowWorkbench.SmallGridGeometry}" />

    <DrawingBrush x:Key="WorkflowWorkbench.LargeGridBrush"
                  TileMode="Tile"
                  Opacity="0.6"
                  Viewport="0 0 120 120"
                  ViewportUnits="Absolute"
                  Drawing="{StaticResource WorkflowWorkbench.LargeGridGeometry}" />

    <ControlTemplate x:Key="WorkflowWorkbench.NodeConnectorTemplate"
                     TargetType="Control">
        <Grid Width="14"
              Height="14">
            <Ellipse Fill="{TemplateBinding Background}"
                     Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="2" />
            <Ellipse Width="6"
                     Height="6"
                     Fill="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="WorkflowWorkbench.SelectionRectangleStyle"
           TargetType="Rectangle"
           BasedOn="{StaticResource NodifyEditor.SelectionRectangleStyle}">
        <Setter Property="StrokeThickness"
                Value="2" />
        <Setter Property="StrokeDashArray"
                Value="5 4" />
        <Setter Property="RadiusX"
                Value="12" />
        <Setter Property="RadiusY"
                Value="12" />
    </Style>

    <Style x:Key="WorkflowWorkbench.EditorStyle"
           TargetType="{x:Type studioNodify:NodifyEditor}"
           BasedOn="{StaticResource {x:Type nodify:NodifyEditor}}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource WorkflowWorkbench.CanvasTextBrush}" />
        <Setter Property="SelectionRectangleStyle"
                Value="{StaticResource WorkflowWorkbench.SelectionRectangleStyle}" />
    </Style>

    <Style x:Key="WorkflowWorkbench.ItemContainerStyle"
           TargetType="{x:Type studioNodify:ItemContainer}"
           BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="SelectedBorderThickness"
                Value="4" />
    </Style>

    <Style x:Key="WorkflowWorkbench.NodeStyle"
           TargetType="{x:Type studioNodify:Node}"
           BasedOn="{StaticResource {x:Type nodify:Node}}">
        <Setter Property="MinWidth"
                Value="200" />
        <Setter Property="ContentPadding"
                Value="6 4" />
    </Style>

    <Style x:Key="WorkflowWorkbench.NodeInputStyle"
           TargetType="{x:Type studioNodify:NodeInput}"
           BasedOn="{StaticResource {x:Type nodify:NodeInput}}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource WorkflowWorkbench.PortInputBrush}" />
        <Setter Property="Padding"
                Value="2 2" />
        <Setter Property="ConnectorTemplate"
                Value="{StaticResource WorkflowWorkbench.NodeConnectorTemplate}" />
    </Style>

    <Style x:Key="WorkflowWorkbench.NodeOutputStyle"
           TargetType="{x:Type studioNodify:NodeOutput}"
           BasedOn="{StaticResource {x:Type nodify:NodeOutput}}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource WorkflowWorkbench.PortOutputBrush}" />
        <Setter Property="Padding"
                Value="2 2" />
        <Setter Property="ConnectorTemplate"
                Value="{StaticResource WorkflowWorkbench.NodeConnectorTemplate}" />
    </Style>

    <Style x:Key="WorkflowWorkbench.LineConnectionStyle"
           TargetType="{x:Type studioNodify:LineConnection}"
           BasedOn="{StaticResource {x:Type nodify:LineConnection}}">
        <Setter Property="StrokeThickness"
                Value="4" />
        <Setter Property="Stroke"
                Value="{DynamicResource LineConnection.StrokeBrush}" />
        <Setter Property="Fill"
                Value="{DynamicResource LineConnection.StrokeBrush}" />
        <Setter Property="StrokeLineJoin"
                Value="Round" />
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
    </Style>

    <Style x:Key="WorkflowWorkbench.PendingConnectionStyle"
           TargetType="{x:Type studioNodify:PendingConnection}"
           BasedOn="{StaticResource {x:Type nodify:PendingConnection}}">
        <Setter Property="Background"
                Value="{DynamicResource PendingConnection.BackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PendingConnection.BorderBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource PendingConnection.ForegroundBrush}" />
        <Setter Property="Stroke"
                Value="{DynamicResource PendingConnection.StrokeBrush}" />
        <Setter Property="StrokeThickness"
                Value="3" />
        <Setter Property="Padding"
                Value="10 6" />
    </Style>

    <Style x:Key="WorkflowWorkbench.SidebarCardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource WorkflowWorkbench.PanelBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="16" />
    </Style>

    <Style x:Key="WorkflowWorkbench.SurfaceCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource WorkflowWorkbench.SidebarCardStyle}">
        <Setter Property="Background"
                Value="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}" />
        <Setter Property="CornerRadius"
                Value="12" />
    </Style>

    <Style x:Key="WorkflowWorkbench.TagBorderStyle"
           TargetType="Border">
        <Setter Property="Padding"
                Value="10 4" />
        <Setter Property="CornerRadius"
                Value="999" />
        <Setter Property="Background"
                Value="{DynamicResource WorkflowWorkbench.AccentSoftBrush}" />
    </Style>

    <Style x:Key="WorkflowWorkbench.SectionTitleTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource WorkflowWorkbench.TextBrush}" />
    </Style>

    <Style x:Key="WorkflowWorkbench.CaptionTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource WorkflowWorkbench.SubtleTextBrush}" />
    </Style>
</ResourceDictionary>
