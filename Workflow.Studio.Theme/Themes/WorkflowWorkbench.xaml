<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nodify="https://miroiu.github.io/nodify"
    xmlns:studioNodify="clr-namespace:Workflow.Studio.Nodify;assembly=Workflow.Studio.Nodify">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Nodify.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <GeometryDrawing
        x:Key="WorkflowWorkbench.SmallGridGeometry"
        Brush="{DynamicResource GridLinesBrush}"
        Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z" />

    <GeometryDrawing
        x:Key="WorkflowWorkbench.LargeGridGeometry"
        Brush="{DynamicResource GridLinesBrush}"
        Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z" />

    <DrawingBrush
        x:Key="WorkflowWorkbench.SmallGridBrush"
        Drawing="{StaticResource WorkflowWorkbench.SmallGridGeometry}"
        TileMode="Tile"
        Viewport="0 0 24 24"
        ViewportUnits="Absolute" />

    <DrawingBrush
        x:Key="WorkflowWorkbench.LargeGridBrush"
        Drawing="{StaticResource WorkflowWorkbench.LargeGridGeometry}"
        Opacity="0.6"
        TileMode="Tile"
        Viewport="0 0 120 120"
        ViewportUnits="Absolute" />

    <ControlTemplate x:Key="WorkflowWorkbench.NodeConnectorTemplate" TargetType="Control">
        <Grid Width="14" Height="14">
            <Ellipse
                Fill="{TemplateBinding Background}"
                Stroke="{TemplateBinding BorderBrush}"
                StrokeThickness="2" />
            <Ellipse
                Width="6"
                Height="6"
                Fill="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <Style
        x:Key="WorkflowWorkbench.SelectionRectangleStyle"
        BasedOn="{StaticResource NodifyEditor.SelectionRectangleStyle}"
        TargetType="Rectangle">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="5 4" />
        <Setter Property="RadiusX" Value="12" />
        <Setter Property="RadiusY" Value="12" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.EditorStyle"
        BasedOn="{StaticResource {x:Type nodify:NodifyEditor}}"
        TargetType="{x:Type studioNodify:NodifyEditor}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.CanvasTextBrush}" />
        <Setter Property="SelectionRectangleStyle" Value="{StaticResource WorkflowWorkbench.SelectionRectangleStyle}" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.ItemContainerStyle"
        BasedOn="{StaticResource {x:Type nodify:ItemContainer}}"
        TargetType="{x:Type studioNodify:ItemContainer}">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="SelectedBorderThickness" Value="4" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.NodeStyle"
        BasedOn="{StaticResource {x:Type nodify:Node}}"
        TargetType="{x:Type studioNodify:Node}">

        <Setter Property="ContentPadding" Value="6 4" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.NodeInputStyle"
        BasedOn="{StaticResource {x:Type nodify:NodeInput}}"
        TargetType="{x:Type studioNodify:NodeInput}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.PortInputBrush}" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource WorkflowWorkbench.NodeConnectorTemplate}" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.NodeOutputStyle"
        BasedOn="{StaticResource {x:Type nodify:NodeOutput}}"
        TargetType="{x:Type studioNodify:NodeOutput}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.PortOutputBrush}" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="ConnectorTemplate" Value="{StaticResource WorkflowWorkbench.NodeConnectorTemplate}" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.LineConnectionStyle"
        BasedOn="{StaticResource {x:Type nodify:LineConnection}}"
        TargetType="{x:Type studioNodify:LineConnection}">
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="Stroke" Value="{DynamicResource LineConnection.StrokeBrush}" />
        <Setter Property="Fill" Value="{DynamicResource LineConnection.StrokeBrush}" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.PendingConnectionStyle"
        BasedOn="{StaticResource {x:Type nodify:PendingConnection}}"
        TargetType="{x:Type studioNodify:PendingConnection}">
        <Setter Property="Background" Value="{DynamicResource PendingConnection.BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PendingConnection.BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PendingConnection.ForegroundBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource PendingConnection.StrokeBrush}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="WorkflowWorkbench.SidebarCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkflowWorkbench.PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style
        x:Key="WorkflowWorkbench.SurfaceCardStyle"
        BasedOn="{StaticResource WorkflowWorkbench.SidebarCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.SubtleBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="WorkflowWorkbench.TagBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="{DynamicResource WorkflowWorkbench.AccentSoftBrush}" />
    </Style>

    <Style x:Key="WorkflowWorkbench.SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.TextBrush}" />
    </Style>

    <Style x:Key="WorkflowWorkbench.CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource WorkflowWorkbench.SubtleTextBrush}" />
    </Style>
</ResourceDictionary>