<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WorkflowWorkbench.PageBackgroundColor">#F3F4F6</Color>
    <Color x:Key="WorkflowWorkbench.PanelBackgroundColor">#FFFFFF</Color>
    <Color x:Key="WorkflowWorkbench.PanelBorderColor">#E5E7EB</Color>
    <Color x:Key="WorkflowWorkbench.SubtleBackgroundColor">#F8FAFC</Color>
    <Color x:Key="WorkflowWorkbench.CanvasOverlayColor">#F8FAFC</Color>
    <Color x:Key="WorkflowWorkbench.CanvasCalloutBackgroundColor">#F2FFFFFF</Color>
    <Color x:Key="WorkflowWorkbench.CanvasCalloutBorderColor">#CBD5E1</Color>
    <Color x:Key="WorkflowWorkbench.CanvasCalloutSecondaryTextColor">#334155</Color>
    <Color x:Key="WorkflowWorkbench.CanvasTextColor">#0F172A</Color>
    <Color x:Key="WorkflowWorkbench.TextColor">#111827</Color>
    <Color x:Key="WorkflowWorkbench.SubtleTextColor">#64748B</Color>
    <Color x:Key="WorkflowWorkbench.AccentColor">#6366F1</Color>
    <Color x:Key="WorkflowWorkbench.AccentSoftColor">#EEF2FF</Color>
    <Color x:Key="WorkflowWorkbench.SecondaryAccentColor">#E0F2FE</Color>
    <Color x:Key="WorkflowWorkbench.SecondaryAccentTextColor">#0369A1</Color>
    <Color x:Key="WorkflowWorkbench.SuccessColor">#16A34A</Color>
    <Color x:Key="WorkflowWorkbench.SuccessSoftColor">#DCFCE7</Color>
    <Color x:Key="WorkflowWorkbench.WarningColor">#D97706</Color>
    <Color x:Key="WorkflowWorkbench.WarningSoftColor">#FEF3C7</Color>
    <Color x:Key="WorkflowWorkbench.ErrorColor">#DC2626</Color>
    <Color x:Key="WorkflowWorkbench.ErrorSoftColor">#FEE2E2</Color>
    <Color x:Key="WorkflowWorkbench.GridColor">#94A3B8</Color>
    <Color x:Key="WorkflowWorkbench.PortInputColor">#818CF8</Color>
    <Color x:Key="WorkflowWorkbench.PortOutputColor">#38BDF8</Color>
    <Color x:Key="WorkflowWorkbench.NodeIndicatorMutedColor">#94A3B8</Color>

    <SolidColorBrush x:Key="WorkflowWorkbench.PageBackgroundBrush"
                     Color="{StaticResource WorkflowWorkbench.PageBackgroundColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.PanelBackgroundBrush"
                     Color="{StaticResource WorkflowWorkbench.PanelBackgroundColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.PanelBorderBrush"
                     Color="{StaticResource WorkflowWorkbench.PanelBorderColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.SubtleBackgroundBrush"
                     Color="{StaticResource WorkflowWorkbench.SubtleBackgroundColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.CanvasOverlayBrush"
                     Color="{StaticResource WorkflowWorkbench.CanvasOverlayColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.CanvasCalloutBackgroundBrush"
                     Color="{StaticResource WorkflowWorkbench.CanvasCalloutBackgroundColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.CanvasCalloutBorderBrush"
                     Color="{StaticResource WorkflowWorkbench.CanvasCalloutBorderColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.CanvasCalloutSecondaryTextBrush"
                     Color="{StaticResource WorkflowWorkbench.CanvasCalloutSecondaryTextColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.CanvasTextBrush"
                     Color="{StaticResource WorkflowWorkbench.CanvasTextColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.TextBrush"
                     Color="{StaticResource WorkflowWorkbench.TextColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.SubtleTextBrush"
                     Color="{StaticResource WorkflowWorkbench.SubtleTextColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.AccentBrush"
                     Color="{StaticResource WorkflowWorkbench.AccentColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.AccentSoftBrush"
                     Color="{StaticResource WorkflowWorkbench.AccentSoftColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.SecondaryAccentBrush"
                     Color="{StaticResource WorkflowWorkbench.SecondaryAccentColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.SecondaryAccentTextBrush"
                     Color="{StaticResource WorkflowWorkbench.SecondaryAccentTextColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.SuccessBrush"
                     Color="{StaticResource WorkflowWorkbench.SuccessColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.SuccessSoftBrush"
                     Color="{StaticResource WorkflowWorkbench.SuccessSoftColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.WarningBrush"
                     Color="{StaticResource WorkflowWorkbench.WarningColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.WarningSoftBrush"
                     Color="{StaticResource WorkflowWorkbench.WarningSoftColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.ErrorBrush"
                     Color="{StaticResource WorkflowWorkbench.ErrorColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.ErrorSoftBrush"
                     Color="{StaticResource WorkflowWorkbench.ErrorSoftColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.NodeIndicatorMutedBrush"
                     Color="{StaticResource WorkflowWorkbench.NodeIndicatorMutedColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.PortInputBrush"
                     Color="{StaticResource WorkflowWorkbench.PortInputColor}" />
    <SolidColorBrush x:Key="WorkflowWorkbench.PortOutputBrush"
                     Color="{StaticResource WorkflowWorkbench.PortOutputColor}" />
    <SolidColorBrush x:Key="GridLinesBrush"
                     Color="{StaticResource WorkflowWorkbench.GridColor}"
                     Opacity="0.45" />

    <Color x:Key="NodifyEditor.BackgroundColor">#F8FAFC</Color>
    <Color x:Key="NodifyEditor.ForegroundColor">#0F172A</Color>
    <Color x:Key="NodifyEditor.SelectionRectangleColor">#60A5FA</Color>
    <Color x:Key="NodifyEditor.PushedAreaColor">#60A5FA</Color>
    <Color x:Key="NodifyEditor.CuttingLineColor">#0F172A</Color>
    <Color x:Key="ItemContainer.BorderColor">#93C5FD</Color>
    <Color x:Key="ItemContainer.SelectedColor">#60A5FA</Color>
    <Color x:Key="Node.BackgroundColor">#FFFFFF</Color>
    <Color x:Key="Node.ContentColor">#F8FAFC</Color>
    <Color x:Key="Node.ForegroundColor">#111827</Color>
    <Color x:Key="Node.HeaderForegroundColor">#111827</Color>
    <Color x:Key="Node.BorderColor">#CBD5E1</Color>
    <Color x:Key="Node.HeaderColor">#FFFFFF</Color>
    <Color x:Key="Node.FooterColor">#F8FAFC</Color>
    <Color x:Key="Connector.BackgroundColor">#FFFFFF</Color>
    <Color x:Key="Connector.ForegroundColor">#111827</Color>
    <Color x:Key="Connector.BorderColor">#94A3B8</Color>
    <Color x:Key="NodeInput.BackgroundColor">#FFFFFF</Color>
    <Color x:Key="NodeInput.ForegroundColor">#111827</Color>
    <Color x:Key="NodeInput.BorderColor">#818CF8</Color>
    <Color x:Key="NodeOutput.BackgroundColor">#FFFFFF</Color>
    <Color x:Key="NodeOutput.ForegroundColor">#111827</Color>
    <Color x:Key="NodeOutput.BorderColor">#38BDF8</Color>
    <Color x:Key="Connection.StrokeColor">#60A5FA</Color>
    <Color x:Key="LineConnection.StrokeColor">#60A5FA</Color>
    <Color x:Key="PendingConnection.StrokeColor">#93C5FD</Color>
    <Color x:Key="PendingConnection.BorderColor">#BFDBFE</Color>
    <Color x:Key="PendingConnection.ForegroundColor">#0F172A</Color>
    <Color x:Key="PendingConnection.BackgroundColor">#EFF6FF</Color>
</ResourceDictionary>
