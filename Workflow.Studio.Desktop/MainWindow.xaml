<Window x:Class="Workflow.Studio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:workbenchViews="clr-namespace:Workflow.Studio.Workbench.Views;assembly=Workflow.Studio.Workbench"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="900"
        Width="1440"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <workbenchViews:WorkflowWorkbenchView DataContext="{Binding Workbench}" />
    </Grid>
</Window>
